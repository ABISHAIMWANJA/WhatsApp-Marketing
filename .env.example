# =============================================================
#  Application
# =============================================================
APP_NAME="WhatsApp Marketing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.com

# Force all generated URLs to https. Turn on once TLS is working.
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Licence / merchant email used for product update checks.
MERCHANT_EMAIL=
APP_UPDATE_URL=https://product-central.livelyworks.net

# =============================================================
#  Logging
# =============================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================================
#  Database
# =============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_marketing
DB_USERNAME=wa_user
DB_PASSWORD=

# =============================================================
#  Session / Cache / Queue
# =============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=

# IMPORTANT: must NOT be "sync" in production. With sync, every bulk
# campaign is sent inside the web request and will time out.
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# =============================================================
#  Redis
# =============================================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# =============================================================
#  Filesystem / Storage
# =============================================================
FILESYSTEM_DRIVER=local
STORAGE_BASE_FOLDER=

# --- AWS S3 (only if FILESYSTEM_DRIVER=s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- DigitalOcean Spaces (only if using Spaces) ---
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_FULL_URL=

# =============================================================
#  Mail
# =============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================
#  Broadcasting (Pusher) — powers the live chat/inbox screens
# =============================================================
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# =============================================================
#  OpenAI — AI reply / content features
# =============================================================
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT=30

# =============================================================
#  Payment gateways (fill in only the ones you use)
# =============================================================
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en

# --- Stripe ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# --- Razorpay ---
RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- YooKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# =============================================================
#  Misc integrations
# =============================================================
MICROSOFT_TRANSLATE_API_KEY=

# Local development only — leave blank in production.
NGROK_URL=
